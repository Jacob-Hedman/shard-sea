---
import Icon from '../../components/Icon.astro';
import Layout from '../../components/Layout.astro';
import EntityDetail from '../../components/EntityDetail.astro';
import { SECTIONS, sectionByRoute, allFacets, isPages, sectionCode, GROUP_COLOR } from '../../lib/sections';
import { loadMeta, countFor, loadFull } from '../../lib/data';

export function getStaticPaths() {
  return SECTIONS.filter((s) => !s.hidden).map((s) => ({ params: { section: s.route } }));
}

const route = Astro.params.section!;
const section = sectionByRoute(route)!;
const meta = loadMeta();

// ---- prose ('pages') section: the chapter itself, or its chapters as a ledger ----
let prosePages: any[] = [];
if (isPages(section)) {
  prosePages = (loadFull('page') as any[])
    .filter((p) => p.section === section.pageKey)
    .sort((a, b) => (a.chapter_no || 99) - (b.chapter_no || 99) || (a.section_order || 99) - (b.section_order || 99));
}
const single = isPages(section) && prosePages.length === 1 ? prosePages[0] : null;

// ---- records section ----
const count = isPages(section) ? prosePages.length : countFor(meta, section.kind);
const facets = allFacets(section);
---

{single ? (
  <Layout title={single.name} description={section.blurb}>
    <EntityDetail rec={single} />
  </Layout>
) : (
  <Layout title={section.label} description={section.blurb}>
    <section class="ledger-hd pad" style={`--c:${GROUP_COLOR[section.group]}`}>
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Codex</a><span aria-hidden="true">/</span><span>{section.group}</span><span aria-hidden="true">/</span><span aria-current="page">{section.label}</span></nav>
      <div class="ledger-title">
        <span class="code">{sectionCode(section.kind)}</span>
        <h1 class="board" data-t={section.label}>{section.label}</h1>
        <span class="lbl">{count.toLocaleString('en-US')} filed</span>
      </div>
      <p class="blurb">{section.blurb}</p>
      {section.rulesPage && (
        <p class="blurb"><a class="lnk" href={`/pages/${section.rulesPage.slug}`}><Icon name="book-2" /> {section.rulesPage.label} →</a></p>
      )}
    </section>

    {isPages(section) ? (
      <div class="rbody">
        <table class="ledger">
          <caption class="sr-only">{section.label}</caption>
          <thead><tr><th scope="col">Chapter</th><th scope="col" class="hide-sm">Summary</th><th scope="col" class="hide-md">Source</th></tr></thead>
          <tbody>
            {prosePages.map((p, i) => (
              <tr>
                <td class="nm"><span class="n">{String(i + 1).padStart(2, '0')}</span><a href={`/pages/${p.slug}`}>{p.name}</a>{p.chapter && <span class="sub">{p.chapter}</span>}</td>
                <td class="ds hide-sm">{p.summary || <span class="none">—</span>}</td>
                <td class="src hide-md">{p.source}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div
        id="browse"
        data-kind={section.kind}
        data-route={section.route}
        data-facets={JSON.stringify(facets)}
        data-default-sort={section.defaultSort ?? 'name'}
        data-default-include={section.defaultIncludeContent?.join(',') ?? ''}
      >
        <div class="qband">
          <label class="qfield">
            <Icon name="search" />
            <input id="browse-q" type="search" autocomplete="off" spellcheck="false" placeholder={`Name a ${section.singular.toLowerCase()}, or part of one`} aria-label={`Search ${section.label.toLowerCase()} by name`} />
          </label>
          <div class="qmeta">
            <span id="browse-count" class="rsum" aria-live="polite"></span>
            <button type="button" class="tool mob" data-filters-toggle aria-expanded="false">Filters <span class="n"></span></button>
            <div id="browse-chips" class="chips"></div>
            <label class="sortbox lbl">Sort
              <select id="browse-sort" aria-label="Sort order">
                <option value="tier">Tier ↑</option>
                <option value="name">A → Z</option>
              </select>
            </label>
            <div id="browse-ct" class="cts"></div>
          </div>
        </div>
        <div id="browse-cats" class="formband" aria-label="Filters"></div>

        <div class="rbody">
          <table class="ledger">
            <caption class="sr-only">{section.label}, filtered by the form above</caption>
            <thead><tr><th scope="col">Name</th><th scope="col" class="hide-sm">Summary</th><th scope="col" class="hide-md">Source</th></tr></thead>
            <tbody id="browse-results"></tbody>
          </table>
          <button id="browse-more" type="button" class="btn more hidden">Show more</button>
        </div>
      </div>
    )}

    <noscript>
      <p class="pad" style="padding-block:24px">Filtering needs JavaScript. Press <kbd>/</kbd> to search by name instead.</p>
    </noscript>

    <script>
      import { initBrowse } from '../../scripts/browse';
      // Runs on first load and after every View Transitions navigation; browse.ts
      // guards against re-initialising the same #browse element.
      document.addEventListener('astro:page-load', initBrowse);
      // Phones: the filter form folds away behind one button.
      document.addEventListener('click', (e) => {
        const b = (e.target as Element).closest('[data-filters-toggle]');
        if (!b) return;
        const open = document.getElementById('browse')?.classList.toggle('filters-open');
        b.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </Layout>
)}
