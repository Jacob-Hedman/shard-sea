---
import Layout from '../components/Layout.astro';
import { loadChanges } from '../lib/data';
import { hrefFor, labelMap } from '../lib/sections';
import { siteChangelog } from '../lib/siteChangelog';

const { current, versions, changelog } = loadChanges();
const HEADING = 'h-mini';
const fmtDate = (s?: string) => (s ? s.slice(0, 10) : '');

// group a flat list of {kind,name,slug,...} by kind for tidy display
function byKind(list: any[]) {
  const m = new Map<string, any[]>();
  for (const c of list) (m.get(c.kind) ?? m.set(c.kind, []).get(c.kind)!).push(c);
  return [...m.entries()].sort((a, b) => a[0].localeCompare(b[0]));
}
const kindLabel = (k: string, n: number) => `${labelMap[k] ?? k}${n === 1 ? '' : 's'}`;

const TAG_CLASS: Record<string, string> = {
  feature: 'border-gold/40 bg-gold/5 text-gold',
  fix: 'border-nonogl/40 bg-nonogl/5 text-nonogl',
  content: 'border-ogl/40 bg-ogl/5 text-ogl',
};

// Homebrew content added to the codex OUTSIDE the PHB (from custom/*.md). Shown in the
// book log because it expands the browsable game content — but it is NOT a PHB version
// change, so it sits in its own clearly-marked block above the version diffs.
// NB: Spirit Binding and the Gaea Magic Items began here as homebrew and became official
// in PHB v1.8 — they now live in the book (see the v18 highlights), not this list.
const homebrew = [
  { section: 'Martech', route: '/martech', n: 20, note: 'cybernetic Moduli, Residue-fuelled body augmentations' },
  { section: 'Artifice — custom', route: '/artifice', n: 17, note: 'Ordnance, Relics, Augmented Equipment & Magical Items' },
  { section: 'Weapons — Utari', route: '/weapons', n: 4, note: 'firearms, plus the Firearms Group Effects' },
  { section: 'Materials — custom', route: '/materials', n: 2, note: 'Antimony, for Weapons and Armor (and its Unique Resource Value)' },
  { section: 'Magic Items — custom', route: '/magic-items', n: 3, note: 'Lambent Clutch, Aegis Band, Band of Comradery' },
  { section: 'Consumables — custom', route: '/consumables', n: 1, note: 'a poison (Agony)' },
];

// Curated, player-facing highlights for a book version — the "what's new / does this
// affect my character?" summary that sits above the exhaustive auto-generated diff.
// Keyed by version_to. Tags reuse the site chip styles (feature = new rule/mechanic,
// content = new browsable content, fix = a change or rebalance to existing rules).
const bookHighlights: Record<string, { tag: 'feature' | 'fix' | 'content'; text: string }[]> = {
  v19: [
    { tag: 'fix', text: 'Strain is now a single type. The Standard / Persistent / Permanent split is gone, and every “Persistent Strain” cost in the book (Necessary Evil, Mortal Blow, Emergency Use, the Regeneration Rune, Beelzebub…) is now plain Strain. Strain is removed by Resting or by Actions and effects that shed it: Catching your Breath sheds all Strain in one Minute if you are not over your Reserve; Rest sheds Strain equal to your Tier (one Watch), twice your Tier + Reserve (two) or all of it (three). Going a Day without Rest lowers your Mind by one.' },
    { tag: 'feature', text: 'New — Second Wind: after being Incapacitated you shed all Strain but suffer 1d6 Corruption. The Overload rule is gone.' },
    { tag: 'fix', text: 'Injuries are substantially more painful. They no longer carry Permanent Strain; instead most results now lower Abilities directly (e.g. Gash: −1 Reflex or Body; Rent Lung: −3 Body and Reflex; Burns: −1/−2/−3 Body, +1 per 6). All Cutting Injuries cause Bleeding, Thoracic Fracture and Break leave you Vulnerable_3, Chaos Burn penalises all Abilities by your Tier, and Recovery Time is now ten times the incurring Damage. Untreated Major Injuries kill after 10 Days. Re-check any Injuries on your sheet.' },
    { tag: 'content', text: 'New Activities for the adventuring day — ten-minute Exclusive Activities that shed one Strain (all of it if you drop to your Reserve or below), each with a bonus: Steady (act first if Initiative starts), Contemplate (a Boon for the next Day), Lay Back (cut an Injury’s Recovery Time) and Brood (trade Corruption for 1d6 Strain).' },
    { tag: 'fix', text: 'Disciplines buffed to handle Strain: Athletics (Warmed Up — The Joy of Motion), Tumble (Slip — Feel the Rush), Bulwark (Iron Stance — Rebound, and the Stance now grants Resistence:1_All), Scavenging (One Eye Open — Save It), Assassin (Sneak Attack — Critical Effect) and Wisdom (Meditation also sheds Strain equal to your Tier) all gained ways to shed Strain. Alchemy’s Succor Mutagen now sheds a Strain; Iron Will’s Tempering resists Mind effects unless their Tier exceeds your Mind and Iron Will.' },
    { tag: 'fix', text: 'Initiative now adds 1d6: all combatants roll 1d6 + Reflex, highest goes first.' },
    { tag: 'fix', text: 'Archetypes: Warrior now gains Reserve equal to Tier while Frenzied and can Frenzy at will (min. three Rounds); Immutable pays Strain equal to its Tier to negate Injury Risk; Champion lost the Persistent-Strain shed; Guardian’s Dark response sheds plain Strain.' },
    { tag: 'fix', text: 'Actions gained four Action Types (Primary, Movement, Reaction, General); Strike’s Critical Effect is now “more Vicious by your Tier”; Aid only needs the Skill (no rank minimum); several Opposed actions are now worded “Resisted by”. Environment: Extreme Cold lowers Reflex by T and Extreme Heat lowers Body by T; thirst lowers all Abilities by twice your Tier per Day, hunger by one per Day; Suffocation kills if you are Incapacitated while Suffocating.' },
    { tag: 'fix', text: 'Smaller changes: “Qualities” are now called Traits; Arcane Magic’s Generate costs Strain instead of Corruption; Surgery treatment alleviates Ability penalties for a Day; First-Aid reduces Recovery Time by one per day; Dragon Slayer is Impaling(4); Diamond Durability is 20; Objects no longer take bonus Notches from heavy hits; Whistling in the Dark lowers Panic severity by one step. Plus misc typo corrections (Encumbrance, Resistence:1_All, “accept their mortality”…).' },
  ],
  v18: [
    { tag: 'feature', text: 'New mechanic — Damage Reduction (DR:x): a Creature or item with DR related to a Damage Type ignores any instance of it that is x or less. It is now used across the book — ship armor, the Lesser Rings, Brawling — and the new Penetration weapon Trait can bypass it.' },
    { tag: 'content', text: 'New condition — Poisoned: you suffer one Standard Strain at the start of each of your turns. It is applied on the sheet like any other condition, and the reworked Deadly substances now inflict it.' },
    { tag: 'fix', text: 'Consumables overhauled. Addictive now makes you roll x Chaos Dice and become Addicted if you roll more 6s than your Mind Bonus. Deadly now rolls x−Height dice — each 6 Poisons you, and you die on more 6s than three times your Body Bonus — and every substance’s Deadly value was rescaled DOWN (e.g. Diablerie 17→7, Fury 10→1, Silvertongue’s poison Deadly 6→3). Secondary durations were dropped (Active_x/y → Active_x). Re-check any consumables your character carries.' },
    { tag: 'fix', text: 'Brawling reworked. “Square Up” now grants DR:1_Physical and lets you Block with a free hand (reducing Damage by your Tier) instead of trading Vicious; the “Combo” flurry now deals only 1 Damage per extra Strike (Pivot Kicks & Pile Drivers exempt).' },
    { tag: 'fix', text: 'Arcane Magic — the Aether-from-Strain feat now costs Corruption to gain (your Tier)d6 Aether (was Standard Strain for double the amount), and it dissipates after one Round. Two Spells were buffed (the Voltaic arc now deals T Damage; the teleport Spell links 1+T Spaces).' },
    { tag: 'fix', text: 'Cities rebuilt. The old zone list is replaced by a City District generator — 15 Districts (Center, Market, Temple, Walls, Nobility, Sewer…), each with its Requirements, Size and Effects — and a City’s Tier is now the sum of its Stat Bonuses. Browse them under City Districts.' },
    { tag: 'fix', text: 'Removed — the tactical Battle system (Unit & Commander cards) and the Defending an Outpost rules are gone from the book; the Battle Cards section is retired.' },
    { tag: 'content', text: 'Now official — the Gaea Magic Items (39) and the whole Spirit Binding discipline (43 Spirits across five Courts) are core PHB v1.8 content. Their custom/faction badges are gone and their wording was polished; see the Changed list below for every reworded effect.' },
    { tag: 'content', text: 'Also new — the Quarterstaff weapon; the Penetration and Delayed_x weapon Traits; explicit damage on every ship weapon; and ships now use DR:x instead of “Immunity to Blunted Damage”.' },
    { tag: 'fix', text: 'Smaller changes worth knowing: social & animal-handling Chaos-die checks now shift on 1-3 (up) / 4-6 (down) instead of only 1 / 6; the Immutable archetype’s response now triggers on being Damaged (was Scraped); Crafting can’t exceed your Creation Tier; the Hull-Plating ship expansion was removed.' },
  ],
};
---

<Layout title="Changelog" description="What changed in each Kriegsmesser PHB version, and every update to this site.">
  <div class="rb-wrap mx-auto max-w-4xl space-y-8">
    <header>
      <h1 class="board pg-h" data-t="Changelog">Changelog</h1>
      <p class="mt-2 text-sm text-faint">
        Two logs: the <span class="text-muted">book</span> — every version of the Kriegsmesser PHB with the exact
        entries added, removed or changed — and the <span class="text-muted">site</span> — updates to this codex and
        its tools. The site always shows the latest book version (<span class="font-mono text-muted">{current}</span>).
      </p>
      <div class="mt-4 flex gap-2" role="tablist">
        <button class="cl-tab rounded-lg border border-line bg-surface px-3.5 py-1.5 text-sm text-muted transition" data-cl-tab="book" data-active="true">Book versions</button>
        <button class="cl-tab rounded-lg border border-line bg-surface px-3.5 py-1.5 text-sm text-muted transition" data-cl-tab="site">Site updates</button>
      </div>
    </header>

    {/* ---- Book (PHB) versions ---- */}
    <section id="tab-book" class="space-y-10">
      {versions.length > 1 && (
        <div class="flex flex-wrap gap-1.5">
          {versions.map((v) => (
            <a href={`#${v.version}`} class="rounded-md border border-line bg-surface px-2 py-0.5 font-mono text-[11px] text-muted transition hover:border-gold/40 hover:text-gold">
              {v.version}
            </a>
          ))}
        </div>
      )}

      {/* Homebrew content — added by the group, outside any PHB version */}
      <section class="rounded-lg border border-arcane/30 bg-arcane/5 p-4">
        <div class="mb-1 flex flex-wrap items-baseline gap-x-2">
          <h2 class="text-lg font-bold text-arcane">Homebrew content</h2>
          <span class="text-xs text-faint">added by the group, outside any PHB version — carried across future book imports</span>
        </div>
        <ul class="mt-2 space-y-1.5">
          {homebrew.map((h) => (
            <li class="flex flex-wrap items-baseline gap-x-2 text-sm text-muted">
              <a href={h.route} class="font-medium text-ink hover:text-gold">{h.section}</a>
              <span class="font-mono text-xs text-ogl">+{h.n}</span>
              <span class="text-faint">— {h.note}</span>
            </li>
          ))}
        </ul>
      </section>

      {changelog.map((b: any) => {
        const isBaseline = (b.baseline?.length ?? 0) > 0 && !b.added?.length && !b.removed?.length && !b.modified?.length;
        const nAdded = b.added?.length ?? 0;
        const nRemoved = b.removed?.length ?? 0;
        const nMod = b.modifiedGrouped?.length ?? 0;
        return (
          <section id={b.version_to} class="scroll-mt-20">
            <div class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-2">
              <h2 class="font-mono text-xl font-bold text-ink">{b.version_to}</h2>
              {b.imported_at && <span class="font-mono text-xs text-faint">{fmtDate(b.imported_at)}</span>}
              {!isBaseline && b.version_from && (
                <span class="text-xs text-faint">compared to <span class="font-mono">{b.version_from}</span></span>
              )}
              {!isBaseline && (
                <div class="ml-auto flex gap-2 font-mono text-[11px]">
                  {nAdded > 0 && <span class="text-ogl">+{nAdded}</span>}
                  {nRemoved > 0 && <span class="text-nonogl">−{nRemoved}</span>}
                  {nMod > 0 && <span class="text-gold">~{nMod}</span>}
                </div>
              )}
            </div>

            {!isBaseline && bookHighlights[b.version_to] && (
              <div class="mb-6 rounded-lg border border-gold/25 bg-gold/5 p-4">
                <h3 class="mb-2 text-sm font-semibold uppercase tracking-[0.08em] text-gold">Highlights — what’s new & what may affect your character</h3>
                <ul class="space-y-2.5">
                  {bookHighlights[b.version_to].map((h) => (
                    <li class="flex gap-2.5 text-sm text-muted">
                      <span class={`mt-0.5 h-fit shrink-0 rounded border px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${TAG_CLASS[h.tag]}`}>{h.tag === 'feature' ? 'new' : h.tag === 'content' ? 'content' : 'change'}</span>
                      <span>{h.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {isBaseline ? (
              <div class="space-y-2">
                <p class="text-sm text-muted">Initial import. The database was seeded with:</p>
                <ul class="grid gap-1 sm:grid-cols-2">
                  {b.baseline.map((c: any) => (
                    <li class="flex items-center gap-2 text-sm text-muted">
                      <span class="h-1 w-1 rounded-full bg-gold/60" aria-hidden="true" />{c.summary}
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <div class="space-y-6">
                {nAdded > 0 && (
                  <div>
                    <h3 class={`${HEADING} mb-2 text-ogl`}>Added — {nAdded}</h3>
                    {byKind(b.added).map(([k, list]) => (
                      <div class="mb-2">
                        <div class="mb-1 text-[11px] uppercase tracking-wide text-faint">{kindLabel(k, list.length)}</div>
                        <div class="flex flex-wrap gap-1.5">
                          {list.map((c: any) => (
                            <a href={hrefFor(c.kind, c.slug)} class="rounded-md border border-ogl/30 bg-ogl/5 px-2 py-0.5 text-xs text-ink transition hover:border-ogl/60">{c.name}</a>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {nRemoved > 0 && (
                  <div>
                    <h3 class={`${HEADING} mb-2 text-nonogl`}>Removed — {nRemoved}</h3>
                    {byKind(b.removed).map(([k, list]) => (
                      <div class="mb-2">
                        <div class="mb-1 text-[11px] uppercase tracking-wide text-faint">{kindLabel(k, list.length)}</div>
                        <div class="flex flex-wrap gap-1.5">
                          {list.map((c: any) => (
                            <span class="rounded-md border border-nonogl/30 bg-nonogl/5 px-2 py-0.5 text-xs text-muted line-through">{c.name}</span>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {nMod > 0 && (
                  <div>
                    <h3 class={`${HEADING} mb-2 text-gold`}>Changed — {nMod}</h3>
                    <ul class="space-y-2.5">
                      {b.modifiedGrouped.map((m: any) => (
                        <li class="card p-3.5">
                          <a href={hrefFor(m.kind, m.slug)} class="font-semibold text-ink hover:text-gold">{m.name}</a>
                          <span class="ml-2 text-[11px] uppercase tracking-wide text-faint">{labelMap[m.kind] ?? m.kind}</span>
                          <ul class="mt-1.5 space-y-1">
                            {m.changes.map((ch: any) => (
                              <li class="text-sm text-muted">
                                <span class="font-medium text-ink">{ch.field}:</span>{' '}
                                {ch.old_value != null && <span class="text-faint line-through">{ch.old_value}</span>}
                                {ch.old_value != null && ch.new_value != null && <span class="text-faint"> → </span>}
                                {ch.new_value != null && <span class="text-ink">{ch.new_value}</span>}
                              </li>
                            ))}
                          </ul>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )}
          </section>
        );
      })}
    </section>

    {/* ---- Site updates ---- */}
    <section id="tab-site" class="hidden space-y-8">
      {siteChangelog.map((e) => (
        <section class="scroll-mt-20">
          <div class="mb-3 flex flex-wrap items-baseline gap-x-3 border-b border-line pb-2">
            <h2 class="text-xl font-bold text-ink">{e.title}</h2>
            <span class="font-mono text-xs text-faint">{e.date}</span>
          </div>
          <ul class="space-y-2.5">
            {e.items.map((it) => (
              <li class="flex gap-2.5 text-sm text-muted">
                <span class={`mt-0.5 h-fit shrink-0 rounded border px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${TAG_CLASS[it.tag]}`}>{it.tag}</span>
                <span>{it.text}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>
  </div>

  <style>
    .cl-tab[data-active='true'] {
      color: var(--color-gold);
      border-color: color-mix(in oklab, var(--color-gold) 40%, transparent);
      background: color-mix(in oklab, var(--color-gold) 6%, var(--color-surface));
    }
  </style>
  <script>
    function initChangelogTabs() {
      const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cl-tab]'));
      const panels: Record<string, HTMLElement | null> = {
        book: document.getElementById('tab-book'),
        site: document.getElementById('tab-site'),
      };
      if (!btns.length) return;
      const show = (tab: string) => {
        for (const [k, el] of Object.entries(panels)) el?.classList.toggle('hidden', k !== tab);
        for (const b of btns) b.setAttribute('data-active', b.dataset.clTab === tab ? 'true' : 'false');
      };
      for (const b of btns) b.addEventListener('click', () => show(b.dataset.clTab || 'book'));
      // Deep links: #site opens the site tab; a version anchor (#v17) opens the book tab.
      if (location.hash === '#site') show('site');
    }
    document.addEventListener('astro:page-load', initChangelogTabs);
  </script>
</Layout>
