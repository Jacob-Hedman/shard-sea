---
import Icon from '../components/Icon.astro';
import Layout from '../components/Layout.astro';
import { sectionsByGroup, sectionByKind, hrefFor, sectionCode, GROUP_COLOR, allFacets, isPages } from '../lib/sections';
import { loadMeta, loadFull, loadIndex, countFor } from '../lib/data';
import { sigilRow, plate, spec, families, themes } from '../lib/sigil';
import { SKILLS } from '../lib/character/rules.mjs';
import { facetValueLabel, jsonForScript } from '../lib/format';

const meta = loadMeta();
const groups = sectionsByGroup();
const total = meta.sections.reduce((a, s) => a + s.count, 0);
const nSections = groups.reduce((a, g) => a + g.sections.length, 0);
const fmt = (n: number) => n.toLocaleString('en-US');

// ---------------------------------------------------------------- the Orrery: curated sets
// Six candidates per set are rendered at build time; the browser picks four at random.
let seed = 35;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const pick = <T,>(arr: T[], n: number) => [...arr].map((x) => [rand(), x] as const).sort((a, b) => a[0] - b[0]).slice(0, n).map((x) => x[1]);
const rowsOf = (kind: string) => loadFull(kind).map((rec: any) => ({ rec, row: sigilRow(rec) }));
const pool = ['feat', 'discipline', 'weapon', 'armor', 'magic_item', 'artifice', 'spirit', 'rune', 'condition', 'skill', 'martech'].flatMap(rowsOf);
const byTheme = (t: string) => pool.filter((x) => themes(x.row).includes(t));
const byAbility = (a: string) => pool.filter((x) => ['feat', 'discipline', 'skill'].includes(x.rec.kind) && families(x.row).includes(a));
const SETS = [
  { name: 'Fire', items: byTheme('Fire') },
  { name: 'Body', items: byAbility('body') },
  { name: 'Mind', items: byAbility('mind') },
  { name: 'Reflex', items: byAbility('reflex') },
  { name: 'Tier 3', items: pool.filter((x) => spec(x.row).power === 'mighty') },
  { name: 'Weapons', items: pool.filter((x) => x.rec.kind === 'weapon') },
  { name: 'Spirits', items: pool.filter((x) => x.rec.kind === 'spirit') },
  { name: 'Custom', items: pool.filter((x) => x.rec.custom) },
].filter((s) => s.items.length >= 2).map((s) => ({ name: s.name, items: pick(s.items, 6) }));
const first = SETS[0].items[0];

// ---------------------------------------------------------------- the index: every section with filter shortcuts
const shortcuts = (kind: string, route: string) => {
  const sec = sectionByKind(kind)!;
  if (isPages(sec)) return [];
  const idx = loadIndex(kind);
  const def = allFacets(sec).find((f) => !['content_type', 'license', 'source', 'custom', 'origin'].includes(f.field));
  if (!def) return [];
  const counts = new Map<string, number>();
  for (const r of idx) for (const v of r.facets?.[def.field] ?? []) counts.set(v, (counts.get(v) ?? 0) + 1);
  return [...counts]
    .filter(([v]) => v && v !== '—')
    .sort((a, b) => b[1] - a[1])
    .slice(0, 4)
    .map(([v, n]) => ({ label: facetValueLabel(def.field, v), n, href: `/${route}?${def.field}=${encodeURIComponent(v)}` }));
};
// Sections with no usable filter get a few of their entries (or chapters) instead.
const samples = (kind: string, route: string) => {
  const sec = sectionByKind(kind)!;
  if (isPages(sec))
    return (loadFull('page') as any[]).filter((p) => p.section === sec.pageKey).slice(0, 4).map((p) => ({ label: p.name, href: `/pages/${p.slug}` }));
  return pick(loadIndex(kind), 4)
    .sort((a: any, b: any) => a.name.localeCompare(b.name))
    .map((r: any) => ({ label: r.name, href: `/${route}/${r.slug}` }));
};
const countLabel = (s: any) => (isPages(s) ? `${(loadFull('page') as any[]).filter((p) => p.section === s.pageKey).length} chapters` : `${fmt(countFor(meta, s.kind))} filed`);
// Two index columns, split between groups so each holds about half the rows.
const indexRows = (g: { sections: unknown[] }) => g.sections.length + 1;
const half = (groups.reduce((a, g) => a + indexRows(g), 0) + 2) / 2;
const indexCols: (typeof groups)[] = [[], []];
{
  let n = 0, col = 0;
  for (const g of groups) {
    if (col === 0 && indexCols[0].length && n + indexRows(g) / 2 > half) col = 1;
    indexCols[col].push(g);
    n += indexRows(g);
  }
}

// ---------------------------------------------------------------- the matrix: rows × Tier
// (the D&D codex's spell matrix, for Kriegsmesser): feats by Skill, or equipment by kind.
const TIERS = [1, 2, 3];
const feats = loadIndex('feat');
const featRows = SKILLS.map((s: any) => s.name);
const EQUIP = ['weapon', 'armor', 'magic_item', 'martech', 'consumable', 'artifice', 'ship'].filter((k) => sectionByKind(k));
const AXES = [
  {
    key: 'skill', label: 'Skill', title: 'Feats', rows: featRows,
    counts: featRows.map((sk: string) => TIERS.map((t) => feats.filter((r: any) => r.facets?.skill?.includes(sk) && r.tier === t).length)),
    hrefs: featRows.map((sk: string) => TIERS.map((t) => `/feats?skill=${encodeURIComponent(sk)}&tier=${encodeURIComponent(`Tier ${t}`)}`)),
  },
  {
    key: 'equipment', label: 'Equipment', title: 'Equipment', rows: EQUIP.map((k) => sectionByKind(k)!.label),
    counts: EQUIP.map((k) => TIERS.map((t) => loadIndex(k).filter((r: any) => r.tier === t).length)),
    hrefs: EQUIP.map((k) => TIERS.map((t) => `/${sectionByKind(k)!.route}?tier=${encodeURIComponent(`Tier ${t}`)}`)),
  },
].map((a) => ({ ...a, max: Math.max(1, ...a.counts.flat()) }));
// black paper: few entries stay dark, many light up
const shade = (n: number, max: number) => {
  if (!n) return '';
  const l = Math.round(8 + Math.min(1, Math.sqrt(n / max)) * 92);
  return `--c:hsl(0 0% ${l}%);--t:${l > 50 ? '#000' : '#fff'}`;
};
const mx0 = AXES[0];

// ---------------------------------------------------------------- start somewhere
const PICKS = ['skill:vitality', 'skill:resolve', 'skill:creation', 'archetype:warrior', 'discipline:brawling', 'discipline:arcane-magic', 'weapon:imperial-saber', 'armor:dragon-armor', 'magic-item:lesser-ring-of-flame', 'condition:poisoned', 'spirit:sylph', 'action:strike'];
const iconic = PICKS.map((k) => {
  const [kind, slug] = k.split(':');
  const kk = kind.replace('-', '_');
  return (loadFull(kk) as any[]).find((r) => r.slug === slug);
}).filter(Boolean) as any[];
---

<Layout>
  <section class="hero">
    <div class="void">
      <div class="orrery" id="orrery" aria-label="The Orrery: sigils drawn from the entries' own data" role="img">
        <svg class="orrery-box" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" style="color:#000" aria-hidden="true"><rect width="400" height="400" fill="#fff"></rect></svg>
        {
          SETS.map((s) => (
            <template data-set={s.name}>
              {s.items.map((x) => (
                <figure data-href={hrefFor(x.rec.kind, x.rec.slug)} data-name={x.rec.name} data-max="0">
                  <Fragment set:html={plate(x.row)} />
                </figure>
              ))}
            </template>
          ))
        }
      </div>
      <a class="stamp" id="orStamp" href={first ? hrefFor(first.rec.kind, first.rec.slug) : '/'}>Orrery · <b>{SETS[0].name}</b></a>
    </div>
    <div class="hero-t">
      <h1>Every rule,<br /><span>on file.</span></h1>
      <p class="msg">{fmt(total)} entries from the Kriegsmesser PHB {meta.version} and the group's own material, indexed and cross-referenced. State what you are looking for. The Codex answers as you type.</p>
      <button type="button" class="hero-q" data-search-open>
        <Icon name="search" /><span>Name an entry: a feat, weapon, condition, spirit…</span><kbd>/</kbd>
      </button>
      <div class="examples" aria-label="Try">
        <a href="/feats?skill=Vitality&tier=Tier%201">Vitality feats, Tier 1</a>
        <a href="/weapons?mode=Ranged">Ranged weapons</a>
        <a href="/conditions?severity=Major">Major conditions</a>
        <a href="/magic-items?tier=Tier%203">Tier 3 magic items</a>
      </div>
      <div class="tally">
        <div><b>{fmt(total)}</b><span>entries</span></div>
        <div><b>{meta.version}</b><span>PHB version</span></div>
        <div><b>{nSections}</b><span>sections</span></div>
      </div>
      <label class="ctbox" title="Custom entries are the GM's own material, outside the book. This preference applies to browsing and search everywhere.">
        <input id="hb-toggle" type="checkbox" /> Include custom (GM-made) content
      </label>
      <div class="recent" id="recent" hidden>
        <span class="recent-h">Recently viewed</span>
        <div class="examples" id="recentList"></div>
      </div>
    </div>
  </section>

  <div class="home-grid">
    <section>
      <div class="blockh"><h2><span id="mxTitle">Feats</span> by <span id="mxAxisName">skill</span></h2><p>Rows × Tier. Select a cell to open the list</p></div>
      <div class="mx-ctl">
        <div class="seg" role="group" aria-label="Rows">
          {AXES.map((a, i) => <button type="button" data-mxa={a.key} aria-pressed={i === 0 ? 'true' : 'false'}>{a.label}</button>)}
        </div>
      </div>
      <div class="mx-scroll">
        <table class="matrix" id="mx">
          <caption class="sr-only">Feats by Skill and Tier</caption>
          <thead><tr><th scope="col"><span class="sr-only">Row</span></th>{TIERS.map((t) => <th scope="col">T{t}</th>)}</tr></thead>
          <tbody>
            {mx0.rows.map((v: string, ri: number) => (
              <tr>
                <th scope="row">{v}</th>
                {mx0.counts[ri].map((n: number, ti: number) => (
                  <td>{n ? <a href={mx0.hrefs[ri][ti]} style={shade(n, mx0.max)} title={`${v}, Tier ${TIERS[ti]}: ${n}`}>{n}</a> : <span>·</span>}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <script type="application/json" id="mxData" set:html={jsonForScript({ axes: AXES, tiers: TIERS })} />
    </section>
    <section>
      <div class="blockh"><h2>Start here</h2><p>Entries people open first</p></div>
      <div class="rel iconic">
        {
          iconic.map((rec) => (
            <a href={hrefFor(rec.kind, rec.slug)}>
              <Fragment set:html={plate(sigilRow(rec))} />
              <span><b>{rec.name}</b><small>{sectionByKind(rec.kind)?.singular}</small></span>
            </a>
          ))
        }
      </div>
    </section>
    <section id="index" class="span">
      <div class="blockh"><h2>Index</h2><p>Every section, with shortcuts into its most-used filter</p></div>
      <div class="index-cols">
        {
          indexCols.map((col, ci) => (
            <table class="index">
              <tbody>
                {col.map((g) => (
                  <Fragment>
                    <tr class="grp"><td colspan="3" style={`--c:${GROUP_COLOR[g.group]}`}>{g.group}</td></tr>
                    {g.sections.map((s) => {
                      const qs = shortcuts(s.kind, s.route);
                      return (
                        <tr style={`--c:${GROUP_COLOR[g.group]}`}>
                          <td class="code">{sectionCode(s.kind)}</td>
                          <td class="nm"><a href={`/${s.route}`}>{s.label}</a><small>{countLabel(s)}</small></td>
                          <td class="qf">
                            {qs.length
                              ? qs.map((q) => (
                                  <a href={q.href}>
                                    {q.label}
                                    <small>{fmt(q.n)}</small>
                                  </a>
                                ))
                              : samples(s.kind, s.route).map((q) => <a class="ent" href={q.href}>{q.label}</a>)}
                          </td>
                        </tr>
                      );
                    })}
                  </Fragment>
                ))}
                {ci === indexCols.length - 1 && (
                  <Fragment>
                    <tr class="grp"><td colspan="3">Tools</td></tr>
                    <tr><td class="code">··</td><td class="nm"><a href="/characters">Characters</a><small>builder &amp; sheets</small></td><td class="qf"><a href="/compare">Compare</a><a href="/changelog">Changelog</a><a href="/about">About</a></td></tr>
                  </Fragment>
                )}
              </tbody>
            </table>
          ))
        }
      </div>
    </section>
  </div>

  <script>
    import { orrery } from '../scripts/sigil';
    import { getExcluded, toggleExcluded } from '../scripts/prefs';
    import { getRecent } from '../scripts/recent';

    let scene: { stop(): void; nudge(): void } | null = null;

    // The matrix: redraw the table body for the chosen rows (axis).
    type Axis = { key: string; label: string; title: string; rows: string[]; counts: number[][]; hrefs: string[][]; max: number };
    function matrix() {
      const data = document.getElementById('mxData');
      const table = document.getElementById('mx');
      if (!data || !table || table.dataset.init) return;
      table.dataset.init = '1';
      const MX: { axes: Axis[]; tiers: number[] } = JSON.parse(data.textContent || '{}');
      let axis = MX.axes[0];
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
      const shade = (n: number) => {
        const l = Math.round(8 + Math.min(1, Math.sqrt(n / axis.max)) * 92);
        return `--c:hsl(0 0% ${l}%);--t:${l > 50 ? '#000' : '#fff'}`;
      };
      const draw = () => {
        const body = axis.rows
          .map((v, ri) => {
            const cells = axis.counts[ri]
              .map((n, ti) => `<td>${n ? `<a href="${esc(axis.hrefs[ri][ti])}" style="${shade(n)};--i:${ti + ri}" title="${esc(v)}, Tier ${MX.tiers[ti]}: ${n}">${n}</a>` : '<span>·</span>'}</td>`)
              .join('');
            return `<tr><th scope="row">${esc(v)}</th>${cells}</tr>`;
          })
          .join('');
        table.querySelector('tbody')!.innerHTML = body;
        table.querySelector('caption')!.textContent = `${axis.title} by ${axis.label.toLowerCase()} and Tier`;
        const name = document.getElementById('mxAxisName');
        if (name) name.textContent = axis.label.toLowerCase();
        const title = document.getElementById('mxTitle');
        if (title) title.textContent = axis.title;
        table.classList.remove('mx-in');
        void table.offsetWidth;
        table.classList.add('mx-in');
      };
      document.querySelector('.mx-ctl')?.addEventListener('click', (e) => {
        const b = (e.target as Element).closest<HTMLElement>('[data-mxa]');
        if (!b) return;
        document.querySelectorAll('[data-mxa]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        axis = MX.axes.find((a) => a.key === b.dataset.mxa) ?? axis;
        draw();
      });
    }
    const init = () => {
      scene?.stop();
      scene = null;
      const host = document.getElementById('orrery');
      if (!host) return;
      const stamp = document.getElementById('orStamp') as HTMLAnchorElement | null;
      scene = orrery(host, (fig, set) => {
        if (!stamp) return;
        stamp.href = fig.dataset.href ?? '/';
        stamp.innerHTML = '';
        stamp.append(`Orrery · ${set} · `, Object.assign(document.createElement('b'), { textContent: fig.dataset.name ?? '' }), ' · open →');
      });
      const cb = document.getElementById('hb-toggle') as HTMLInputElement | null;
      if (cb && !cb.dataset.init) {
        cb.dataset.init = '1';
        cb.checked = !getExcluded().has('custom');
        cb.addEventListener('change', () => toggleExcluded('custom'));
      }
      matrix();
      const recent = getRecent().slice(0, 6);
      const box = document.getElementById('recent');
      const list = document.getElementById('recentList');
      if (box && list && recent.length) {
        list.replaceChildren(...recent.map((r) => Object.assign(document.createElement('a'), { href: r.h, textContent: r.n })));
        box.hidden = false;
      }
    };
    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', () => { scene?.stop(); scene = null; });
    document.addEventListener('keydown', () => scene?.nudge());
  </script>
</Layout>
