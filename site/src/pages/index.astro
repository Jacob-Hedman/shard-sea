---
import Layout from '../components/Layout.astro';
import { sectionsByGroup, sectionByKind, hrefFor } from '../lib/sections';
import { loadMeta, loadFull, countFor } from '../lib/data';

const meta = loadMeta();
const groups = sectionsByGroup();
const total = meta.sections.reduce((a, s) => a + s.count, 0);

// A pool of evocative entry points; the client shows a rotating random handful.
// Verified against the exported data at build time — anything missing drops out.
const PICKS: { kind: string; slug: string }[] = [
  { kind: 'archetype', slug: 'warrior' }, { kind: 'archetype', slug: 'hero' },
  { kind: 'archetype', slug: 'guardian' }, { kind: 'archetype', slug: 'champion' },
  { kind: 'archetype', slug: 'opportunist' }, { kind: 'archetype', slug: 'immutable' },
  { kind: 'discipline', slug: 'tumble' }, { kind: 'discipline', slug: 'arcane-magic' },
  { kind: 'discipline', slug: 'faith' }, { kind: 'discipline', slug: 'athletics' },
  { kind: 'discipline', slug: 'brawling' }, { kind: 'discipline', slug: 'assassin' },
  { kind: 'feat', slug: 'drive' }, { kind: 'feat', slug: 'continuity' },
  { kind: 'feat', slug: 'iron-will' }, { kind: 'feat', slug: 'focus' },
  { kind: 'rune', slug: 'void' }, { kind: 'rune', slug: 'weight' },
  { kind: 'weapon', slug: 'kiering' }, { kind: 'weapon', slug: 'ikon' },
  { kind: 'weapon', slug: 'katasin' }, { kind: 'armor', slug: 'dragon-armor' },
  { kind: 'armor', slug: 'buckler' }, { kind: 'condition', slug: 'on-fire' },
  { kind: 'condition', slug: 'bleeding' }, { kind: 'condition', slug: 'frenzied' },
  { kind: 'action', slug: 'strike' }, { kind: 'action', slug: 'maneuver' },
  { kind: 'page', slug: 'the-sea' }, { kind: 'page', slug: 'the-wheel-of-wheels' },
  { kind: 'page', slug: 'gaia' },
];
const byKind = new Map<string, Map<string, any>>();
for (const kind of [...new Set(PICKS.map((p) => p.kind))]) {
  byKind.set(kind, new Map(loadFull(kind).map((r: any) => [r.slug, r])));
}
const popular = PICKS.map((p) => {
  const rec = byKind.get(p.kind)?.get(p.slug);
  return rec ? { ...p, name: rec.name, icon: sectionByKind(p.kind)?.icon ?? 'ti-link' } : null;
}).filter(Boolean) as { kind: string; slug: string; name: string; icon: string }[];

const statChip =
  'inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-3 py-1.5 text-xs text-muted';
---

<Layout>
  <div class="mx-auto max-w-6xl">
    <h1 class="text-4xl font-bold tracking-tighter sm:text-5xl sm:leading-tight">
      <span class="bg-gradient-to-br from-ink to-gold bg-clip-text text-transparent">Shard-sea Codex</span>
    </h1>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-muted">
      A living reference for <span class="text-ink">Kriegsmesser</span> — every discipline, feat, weapon,
      condition and rule, searchable, filterable and always up to date with the latest playtest.
    </p>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class={statChip}>
        <i class="ti ti-database text-sm text-gold/80" aria-hidden="true"></i>
        <span class="font-mono text-ink">{total.toLocaleString()}</span> entries
      </span>
      <span class={statChip}>
        <i class="ti ti-category-2 text-sm text-gold/80" aria-hidden="true"></i>
        <span class="font-mono text-ink">{meta.sections.length}</span> categories
      </span>
      <a href="/changelog" class={`${statChip} transition hover:border-gold/40 hover:text-ink`}>
        <i class="ti ti-versions text-sm text-gold/80" aria-hidden="true"></i>
        <span class="font-mono text-ink">{meta.version}</span> — see changes
      </a>
      <button
        type="button"
        data-search-open
        class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-3 py-1.5 text-xs text-muted transition hover:border-gold/40 hover:text-ink"
      >
        <i class="ti ti-search text-sm text-gold/80" aria-hidden="true"></i>
        Search everything
        <kbd class="rounded border border-line bg-surface-2 px-1 font-mono text-[10px] text-faint">⌘K</kbd>
      </button>
    </div>

    {
      popular.length > 0 && (
        <div class="mt-8">
          <div class="mb-2.5 flex items-center gap-2">
            <h2 class="text-[11px] font-semibold uppercase tracking-[0.12em] text-faint">Start somewhere</h2>
            <button
              type="button"
              data-iconic-shuffle
              aria-label="Shuffle picks"
              title="Shuffle"
              class="text-faint transition hover:text-gold"
            >
              <i class="ti ti-refresh text-xs" aria-hidden="true" />
            </button>
          </div>
          <div id="iconic-pool" class="flex flex-wrap gap-2 transition-opacity duration-200">
            {popular.map((p, i) => (
              <a
                href={hrefFor(p.kind, p.slug)}
                class:list={[
                  'iconic-pick group items-center gap-2 rounded-lg border border-line bg-surface px-3 py-1.5 text-sm text-muted transition hover:border-gold/40 hover:bg-surface-2 hover:text-ink',
                  i < 8 ? 'inline-flex' : 'hidden',
                ]}
              >
                <i class:list={['ti', p.icon, 'text-sm text-faint transition group-hover:text-gold']} aria-hidden="true" />
                {p.name}
              </a>
            ))}
          </div>
        </div>
      )
    }

    <script>
      const COUNT = 8;
      function pickSome(pool: HTMLElement) {
        const items = Array.from(pool.querySelectorAll<HTMLElement>('.iconic-pick'));
        const order = items.slice().sort(() => Math.random() - 0.5);
        items.forEach((el) => (el.style.display = 'none'));
        order.slice(0, COUNT).forEach((el) => (el.style.display = 'inline-flex'));
      }
      function rotate(pool: HTMLElement) {
        pool.style.opacity = '0';
        window.setTimeout(() => { pickSome(pool); pool.style.opacity = '1'; }, 200);
      }
      function initIconic() {
        const pool = document.getElementById('iconic-pool');
        if (!pool) return;
        if (window.__iconicTimer) window.clearInterval(window.__iconicTimer);
        pickSome(pool);
        pool.style.opacity = '1';
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) window.__iconicTimer = window.setInterval(() => rotate(pool), 6500);
      }
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('[data-iconic-shuffle]')) {
          const pool = document.getElementById('iconic-pool');
          if (pool) rotate(pool);
        }
      });
      document.addEventListener('astro:page-load', initIconic);
      document.addEventListener('astro:before-swap', () => {
        if (window.__iconicTimer) window.clearInterval(window.__iconicTimer);
      });
    </script>

    {
      groups.map((g) => (
        <section class="mt-10">
          <h2 class="mb-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-faint">{g.group}</h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {g.sections.map((s) => (
              <a href={`/${s.route}`} class="card card-hover group flex items-start gap-3 p-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-line bg-surface-2 transition group-hover:border-gold/30">
                  <i class:list={['ti', s.icon, 'text-lg text-muted transition group-hover:text-gold']} aria-hidden="true" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="flex items-baseline justify-between gap-2">
                    <span class="font-semibold text-ink">{s.label}</span>
                    <span class="font-mono text-xs text-faint">{countFor(meta, s.kind).toLocaleString()}</span>
                  </span>
                  <p class="mt-0.5 line-clamp-2 text-[13px] leading-snug text-muted">{s.blurb}</p>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>
