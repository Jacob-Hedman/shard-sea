---
import Layout from '../components/Layout.astro';
import { loadMeta, loadChanges } from '../lib/data';

const meta = loadMeta();
const { versions } = loadChanges();
const HEADING = 'mb-3 text-[13px] font-semibold uppercase tracking-[0.08em] text-muted';
---

<Layout title="About" description="What the Shard-sea Codex is and how it stays in sync with the game.">
  <div class="mx-auto max-w-4xl space-y-10">
    <header>
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">About the Codex</h1>
      <p class="mt-2 text-sm text-faint">A reference for a game that keeps changing.</p>
    </header>

    <section>
      <h2 class={HEADING}>What this is</h2>
      <div class="prose-dnd space-y-3">
        <p>
          The Shard-sea Codex is a browsable reference for <span class="text-ink">Kriegsmesser</span>, the
          tabletop RPG set in the Shard-sea. It's a work in progress that changes regularly — sometimes
          fundamentally — so this site is built to keep up: the entire Player's Handbook is imported straight
          from the source, and every version is diffed so you can see exactly what changed.
        </p>
        <p>
          Everything you see — disciplines, feats, weapons, conditions, rules and lore — is generated from the
          latest imported PHB. The site always shows the newest version; the
          <a href="/changelog" class="text-gold hover:underline">changelog</a> records the precise differences
          between versions.
        </p>
      </div>
    </section>

    <section>
      <h2 class={HEADING}>How updates work</h2>
      <div class="card px-4 py-3">
        <ol class="space-y-2 text-sm text-muted">
          <li class="flex gap-2"><span class="font-mono text-gold">1</span> A new PHB version is exported from Obsidian as a markdown vault.</li>
          <li class="flex gap-2"><span class="font-mono text-gold">2</span> The importer parses it into the database and computes a detailed diff against the previous version.</li>
          <li class="flex gap-2"><span class="font-mono text-gold">3</span> The site rebuilds — the content updates and the new differences appear in the changelog.</li>
        </ol>
      </div>
      <p class="mt-3 text-xs leading-relaxed text-faint">
        Kriegsmesser and the Shard-sea setting are the work of their creators. This is a private,
        password-protected reference for the playtest group — nothing here is published or sold.
      </p>
    </section>

    <section>
      <h2 class={HEADING}>Versions</h2>
      <ol class="relative space-y-4 border-l border-line pl-5">
        {versions.map((v) => (
          <li class="relative">
            <span class="absolute -left-[1.45rem] top-1.5 h-2 w-2 rounded-full border border-gold/60 bg-gold/30" aria-hidden="true" />
            <div class="flex items-baseline gap-2">
              <a href={`/changelog#${v.version}`} class="font-mono text-sm font-semibold text-ink hover:text-gold">{v.version}</a>
              {v.is_current ? <span class="rounded border border-gold/40 bg-gold/10 px-1.5 text-[10px] uppercase tracking-wide text-gold">current</span> : null}
              <span class="font-mono text-[11px] text-faint">{(v.imported_at || '').slice(0, 10)}</span>
            </div>
            <p class="mt-0.5 text-xs text-faint">{v.entity_count} entries · {v.page_count} pages</p>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Layout>
