---
import Layout from '../components/Layout.astro';
---

<Layout title="Page not found" description="This page rolled a natural 1.">
  <section class="nf pad">
    <p class="lbl">Error 404 · file not found</p>
    <h1 class="board" data-t="Not on file.">Not on file.</h1>
    <p class="msg">This page rolled a natural 1. The file you asked for is not in the Codex, or it moved.</p>
    <div class="badges" style="gap:10px">
      <button type="button" class="btn red" data-search-open>Search the Codex <kbd>/</kbd></button>
      <a class="btn" href="/">Back to the index</a>
    </div>
  </section>
</Layout>
