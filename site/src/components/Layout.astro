---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import TopBar from './TopBar.astro';
import Sidebar from './Sidebar.astro';
import GlobalSearch from './GlobalSearch.astro';
import { loadMeta } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Shard-sea Codex',
  description = 'A searchable reference for Kriegsmesser — disciplines, feats, weapons, conditions and rules.',
} = Astro.props;
const fullTitle = title === 'Shard-sea Codex' ? title : `${title} · Shard-sea Codex`;
const path = Astro.url.pathname;
const meta = loadMeta();
const totalEntries = meta.sections.reduce((a, s) => a + s.count, 0);
const builtDate = String(meta.builtAt ?? '').slice(0, 10);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0c0e" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shard-sea Codex" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3/dist/tabler-icons.min.css"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="fixed left-4 top-3 z-[60] -translate-y-20 rounded-md border border-line-strong bg-surface px-3 py-2 text-sm font-medium text-ink transition focus:translate-y-0"
      >Skip to content</a
    >
    <TopBar />
    <div class="mx-auto flex w-full max-w-[100rem]">
      <Sidebar currentPath={path} />
      <main id="main" tabindex="-1" class="min-w-0 flex-1 px-4 py-8 sm:px-6 lg:px-10">
        <slot />
      </main>
    </div>
    <footer
      class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line px-4 py-6 text-xs text-faint sm:px-6 lg:px-10"
    >
      <span>
        <a href="/about" class="underline transition hover:text-muted">About</a> ·
        <a href="/changelog" class="underline transition hover:text-muted">Changelog</a> · Generated from the latest
        Kriegsmesser PHB. Kriegsmesser &amp; the Shard-sea setting are © their creators; shown here for the playtest group.
      </span>
      <span class="font-mono">
        {totalEntries.toLocaleString()} entries{builtDate && ` · data ${builtDate}`}
      </span>
    </footer>

    <button
      type="button"
      id="to-top"
      aria-label="Back to top"
      class="fixed bottom-5 right-5 z-40 rounded-full border border-line-strong bg-surface/90 p-2.5 text-muted backdrop-blur hover:border-gold/40 hover:text-gold"
    >
      <i class="ti ti-arrow-up text-lg" aria-hidden="true"></i>
    </button>

    <div id="sb-backdrop" class="fixed inset-0 top-14 z-30 hidden bg-black/60 lg:hidden"></div>
    <GlobalSearch />

    <script is:inline>
      // App-shell behaviour. Bound once on `document`/`window` (guarded), with
      // event delegation + element re-querying so it survives the client-side
      // navigation that View Transitions performs (the sidebar/content swap).
      (() => {
        if (window.__shellInit) return;
        window.__shellInit = true;

        const setExpanded = (v) =>
          document
            .querySelectorAll('[data-sidebar-toggle]')
            .forEach((b) => b.setAttribute('aria-expanded', String(v)));
        const drawerOpen = () => {
          const sb = document.getElementById('app-sidebar');
          return !!sb && !sb.classList.contains('-translate-x-full');
        };
        const closeDrawer = () => {
          document.getElementById('app-sidebar')?.classList.add('-translate-x-full');
          document.getElementById('sb-backdrop')?.classList.add('hidden');
          setExpanded(false);
        };
        document.addEventListener('click', (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;
          if (t.closest('[data-sidebar-toggle]')) {
            e.preventDefault();
            const sb = document.getElementById('app-sidebar');
            const bd = document.getElementById('sb-backdrop');
            if (!sb || !bd) return;
            if (sb.classList.contains('-translate-x-full')) {
              sb.classList.remove('-translate-x-full');
              bd.classList.remove('hidden');
              setExpanded(true);
            } else {
              closeDrawer();
            }
          } else if (t.closest('#sb-backdrop') || t.closest('#app-sidebar a')) {
            closeDrawer();
          }
        });
        // Esc closes the mobile drawer (the search overlay handles its own Esc).
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawerOpen()) closeDrawer();
        });

        // "Show more" clamps: collapse long blocks to a preview + toggle.
        document.addEventListener('click', (e) => {
          const btn = e.target instanceof Element ? e.target.closest('[data-clamp-toggle]') : null;
          if (!btn) return;
          const el = btn.closest('[data-clampable]');
          if (!el) return;
          const exp = el.classList.toggle('expanded');
          btn.setAttribute('aria-expanded', String(exp));
        });
        const initClamps = () => {
          document.querySelectorAll('[data-clampable]').forEach((el) => {
            if (el.dataset.cInit) return;
            el.dataset.cInit = '1';
            const body = el.querySelector('.clampable-body');
            const btn = el.querySelector('[data-clamp-toggle]');
            if (!body || !btn) return;
            const lines = parseFloat(el.style.getPropertyValue('--clamp-lines')) || 6;
            const max = lines * 1.7 * parseFloat(getComputedStyle(body).fontSize || '16');
            if (body.scrollHeight > max + 8) {
              el.classList.add('clamped');
              btn.hidden = false;
            }
          });
        };

        // Card cursor-glow: feed pointer position into CSS vars on the hovered card.
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
          window.addEventListener(
            'pointermove',
            (e) => {
              const card = e.target instanceof Element ? e.target.closest('.card-hover') : null;
              if (!card) return;
              const r = card.getBoundingClientRect();
              card.style.setProperty('--mx', `${e.clientX - r.left}px`);
              card.style.setProperty('--my', `${e.clientY - r.top}px`);
            },
            { passive: true },
          );
        }

        // Scroll-aware top bar + "back to top" reveal.
        const syncHeader = () => {
          document.querySelector('header')?.classList.toggle('scrolled', window.scrollY > 8);
          document.getElementById('to-top')?.classList.toggle('show', window.scrollY > 700);
        };
        document.addEventListener('click', (e) => {
          if (e.target instanceof Element && e.target.closest('#to-top')) window.scrollTo(0, 0);
        });
        window.addEventListener('scroll', syncHeader, { passive: true });
        document.addEventListener('astro:page-load', () => {
          closeDrawer();
          syncHeader();
          initClamps();
        });
        syncHeader();
        initClamps();
      })();
    </script>
  </body>
</html>
