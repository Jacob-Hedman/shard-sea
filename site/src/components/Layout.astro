---
import Icon from './Icon.astro';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import GlobalSearch from './GlobalSearch.astro';
import { loadMeta, countFor } from '../lib/data';
import { SECTIONS, sectionsByGroup, GROUP_COLOR, sectionCode, sectionByKind } from '../lib/sections';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Shard-sea Codex',
  description = 'A searchable reference for Kriegsmesser — disciplines, feats, weapons, conditions and rules.',
} = Astro.props;
const fullTitle = title === 'Shard-sea Codex' ? title : `${title} · Shard-sea Codex`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const meta = loadMeta();
const totalEntries = meta.sections.reduce((a, s) => a + s.count, 0);
const builtDate = String(meta.builtAt ?? '').slice(0, 10);
const buildNumber = __BUILD_NUMBER__;
const buildSha = __BUILD_SHA__;
const buildTime = __BUILD_TIME__;
const fmt = (n: number) => n.toLocaleString('en-US');
const visible = SECTIONS.filter((s) => !s.hidden);
// a pages-type section counts its chapters
const countOf = (s: (typeof SECTIONS)[number]) => countFor(meta, s.kind);

// The drawers: the eight most-used sections, then "All sections" for the rest.
const DRAWERS = ['skill', 'discipline', 'feat', 'condition', 'weapon', 'armor', 'artifice', 'magic_item'].map((k) => sectionByKind(k)!);
const isIn = (route: string) => path === `/${route}` || path.startsWith(`/${route}/`);
const inDrawer = DRAWERS.some((s) => isIn(s.route));
const groups = sectionsByGroup();
const short = (l: string) => l.replace(' & Shields', '').replace(' Items', '').replace('Damage & ', '');
const EXTRA = [
  { href: '/pages', label: 'The Book' },
  { href: '/characters', label: 'Characters' },
  { href: '/compare', label: 'Compare' },
  { href: '/changelog', label: 'Changelog' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shard-sea Codex" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <header class="hdr" transition:persist="hdr">
      <a class="wordmark" href="/" aria-label="Shard-sea Codex, home"><span class="tri" aria-hidden="true"></span>Codex <small>Shard-sea</small></a>
      <button type="button" class="hdr-search" data-search-open aria-keyshortcuts="Control+K /">
        <Icon name="search" /><span>Query the Codex</span><kbd>/</kbd>
      </button>
      <div class="hdr-r"><b>{fmt(totalEntries)}</b> entries · PHB <b>{meta.version}</b></div>
    </header>
    <nav class="drawers" aria-label="Sections" data-drawers>
      {/* The tabs scroll sideways on phones; "All sections" stays outside that strip, pinned at its end
          (a pop-up inside a scrolling strip is cut off by it on iPhones). */}
      <div class="drawers-row">
        {
          DRAWERS.map((s) => (
            <a href={`/${s.route}`} style={`--c:${GROUP_COLOR[s.group]}`} aria-current={isIn(s.route) ? 'page' : undefined}>
              <span class="code">{sectionCode(s.kind)}</span>
              <b>{short(s.label)}</b>
              <small>{fmt(countOf(s))} filed</small>
            </a>
          ))
        }
      </div>
      <details data-current={!inDrawer && path !== '/' ? '' : undefined}>
        <summary>
          <span class="code">··</span>
          <b>All sections</b>
          <small>{visible.length} + tools</small>
        </summary>
        <div class="allsec">
          {
            groups.map((g) => (
              <section style={`--c:${GROUP_COLOR[g.group]}`}>
                <h3>{g.group}</h3>
                {g.sections.map((s) => (
                  <a href={`/${s.route}`} aria-current={isIn(s.route) ? 'page' : undefined}>
                    {s.label}
                    <small>{s.type === 'pages' ? 'rules' : fmt(countOf(s))}</small>
                  </a>
                ))}
              </section>
            ))
          }
          <section>
            <h3>Tools</h3>
            {EXTRA.map((x) => <a href={x.href}>{x.label}</a>)}
          </section>
        </div>
      </details>
    </nav>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="ftr">
      <span>
        <a href="/about">About</a> · <a href="/changelog">Changelog</a> · Generated from the latest Kriegsmesser PHB. Kriegsmesser &amp; the Shard-sea setting are © their creators; shown here for the playtest group.
      </span>
      <span>{fmt(totalEntries)} entries{builtDate && ` · data ${builtDate}`}</span>
      <span class="ftr-build" title={`Built ${buildTime}`}>Build {buildNumber} · {buildSha}</span>
    </footer>

    <div id="cmp-tray" class="cmp-tray" role="region" aria-label="Compare" hidden></div>
    <button type="button" id="to-top" aria-label="Back to top"><Icon name="arrow-up" /></button>
    <GlobalSearch />

    <script>
      import { inscribe, bindKeys } from '../scripts/sigil';
      import { recordPage } from '../scripts/recent';
      import { initCompare } from '../scripts/compare';

      // Bound once (guarded): the header persists across View Transitions navigations.
      const w = window as any;
      if (!w.__shellInit) {
        w.__shellInit = true;
        const closeDrawer = () => document.querySelectorAll<HTMLDetailsElement>('[data-drawers] details[open]').forEach((d) => (d.open = false));
        document.addEventListener('click', (e) => {
          const t = e.target as Element;
          if (!t.closest('[data-drawers] details') || t.closest('.allsec a')) closeDrawer();
          if (t.closest('#to-top')) window.scrollTo(0, 0);
          // "Show more" clamps
          const btn = t.closest('[data-clamp-toggle]');
          const el = btn?.closest('[data-clampable]');
          if (btn && el) btn.setAttribute('aria-expanded', String(el.classList.toggle('expanded')));
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });
        const syncTop = () => document.getElementById('to-top')?.classList.toggle('show', window.scrollY > 700);
        // The entry title's red echo slips out of register as the page scrolls away from it.
        let echoFrame = 0;
        const still = matchMedia('(prefers-reduced-motion: reduce)');
        const syncEcho = () => {
          echoFrame = 0;
          const h = document.querySelector<HTMLElement>('.file-hd h1.board');
          if (!h) return;
          const e = still.matches ? 0 : Math.min(1, Math.max(0, window.scrollY / 260));
          h.style.setProperty('--e', e.toFixed(3));
        };
        window.addEventListener('scroll', () => { if (!echoFrame) echoFrame = requestAnimationFrame(syncEcho); }, { passive: true });
        document.addEventListener('astro:page-load', syncEcho);
        window.addEventListener('scroll', syncTop, { passive: true });
        document.addEventListener('astro:before-swap', closeDrawer);
        document.addEventListener('astro:page-load', syncTop);
      }

      const initClamps = () => {
        document.querySelectorAll<HTMLElement>('[data-clampable]').forEach((el) => {
          if (el.dataset.cInit) return;
          el.dataset.cInit = '1';
          const body = el.querySelector<HTMLElement>('.clampable-body');
          const btn = el.querySelector<HTMLElement>('[data-clamp-toggle]');
          if (!body || !btn) return;
          const lines = parseFloat(el.style.getPropertyValue('--clamp-lines')) || 6;
          const max = lines * 1.62 * parseFloat(getComputedStyle(body).fontSize || '16');
          if (body.scrollHeight > max + 8) {
            el.classList.add('clamped');
            btn.hidden = false;
          }
        });
      };
      // Each page: draw its big sigil in, link its zones to the key, measure clamps, and keep the
      // drawer height current for the sticky strips below it.
      const onPage = () => {
        initClamps();
        bindKeys();
        recordPage();
        initCompare();
        document.querySelectorAll('[data-inscribe] svg').forEach((svg) => inscribe(svg));
        const d = document.querySelector<HTMLElement>('[data-drawers]');
        if (d) document.documentElement.style.setProperty('--drw', d.offsetHeight + 'px');
      };
      document.addEventListener('astro:page-load', onPage);
    </script>
  </body>
</html>
