---
import { sectionByKind } from '../lib/sections';
import FeatDetail from './detail/FeatDetail.astro';
import DisciplineDetail from './detail/DisciplineDetail.astro';
import ArchetypeDetail from './detail/ArchetypeDetail.astro';
import WeaponDetail from './detail/WeaponDetail.astro';
import ArmorDetail from './detail/ArmorDetail.astro';
import ConditionDetail from './detail/ConditionDetail.astro';
import ActionDetail from './detail/ActionDetail.astro';
import PageDetail from './detail/PageDetail.astro';
import GenericDetail from './detail/GenericDetail.astro';

interface Props {
  rec: any;
}
const { rec } = Astro.props;
const section = sectionByKind(rec.kind);
const map: Record<string, any> = {
  feat: FeatDetail,
  discipline: DisciplineDetail,
  archetype: ArchetypeDetail,
  weapon: WeaponDetail,
  armor: ArmorDetail,
  condition: ConditionDetail,
  action: ActionDetail,
  page: PageDetail,
};
const Body = map[rec.kind] ?? GenericDetail;
// "In: <chapter page>" context link — but not on the page itself.
const inPage = rec.page_slug && rec.page_slug !== rec.slug ? { slug: rec.page_slug, title: rec.page_title } : null;
---

<article class="mx-auto max-w-6xl">
  <nav class="mb-2 flex flex-wrap items-center gap-1.5 text-sm text-faint">
    <a href="/" class="transition hover:text-gold">Home</a>
    <i class="ti ti-chevron-right text-[11px]" aria-hidden="true"></i>
    {section && <a href={`/${section.route}`} class="transition hover:text-gold">{section.label}</a>}
    <i class="ti ti-chevron-right text-[11px]" aria-hidden="true"></i>
    <span class="truncate text-muted">{rec.name}</span>
  </nav>
  <header class="mb-6 border-b border-line pb-5">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{rec.name}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
      {rec.source && (
        <span class="inline-flex items-center gap-1 rounded-md border border-line bg-surface px-2 py-0.5 font-medium text-faint">
          <i class="ti ti-book text-[13px]" aria-hidden="true"></i>{rec.source}
        </span>
      )}
      {inPage && (
        <a href={`/pages/${inPage.slug}`} class="inline-flex items-center gap-1 rounded-md border border-line bg-surface px-2 py-0.5 font-medium text-muted transition hover:border-gold/40 hover:text-gold">
          <i class="ti ti-file-text text-[13px]" aria-hidden="true"></i>In: {inPage.title}
        </a>
      )}
    </div>
  </header>
  <Body rec={rec} />
</article>
