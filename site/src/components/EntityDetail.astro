---
// An entry file (the D&D 3.5 Codex 1.0 layout): crumbs, file line, title and badges, the facts
// that matter most as a glance grid, and the entry's sigil on the right; below, the body text
// with the side column (the detail component's own side content, then EntrySide).
import { sectionByKind, sectionCode, GROUP_COLOR, hrefFor } from '../lib/sections';
import { factsFor } from '../lib/facts';
import Sigil from './Sigil.astro';
import EntrySide from './EntrySide.astro';
import FeatDetail from './detail/FeatDetail.astro';
import DisciplineDetail from './detail/DisciplineDetail.astro';
import ArchetypeDetail from './detail/ArchetypeDetail.astro';
import WeaponDetail from './detail/WeaponDetail.astro';
import ArmorDetail from './detail/ArmorDetail.astro';
import ConditionDetail from './detail/ConditionDetail.astro';
import ActionDetail from './detail/ActionDetail.astro';
import PageDetail from './detail/PageDetail.astro';
import MaterialDetail from './detail/MaterialDetail.astro';
import ArtificeDetail from './detail/ArtificeDetail.astro';
import RitualDetail from './detail/RitualDetail.astro';
import PactDetail from './detail/PactDetail.astro';
import ConsumableDetail from './detail/ConsumableDetail.astro';
import DamageTypeDetail from './detail/DamageTypeDetail.astro';
import SkillDetail from './detail/SkillDetail.astro';
import SpiritDetail from './detail/SpiritDetail.astro';
import GenericDetail from './detail/GenericDetail.astro';

interface Props {
  rec: any;
}
const { rec } = Astro.props;
const section = sectionByKind(rec.kind);
const map: Record<string, any> = {
  feat: FeatDetail,
  discipline: DisciplineDetail,
  archetype: ArchetypeDetail,
  weapon: WeaponDetail,
  armor: ArmorDetail,
  condition: ConditionDetail,
  action: ActionDetail,
  page: PageDetail,
  material: MaterialDetail,
  artifice: ArtificeDetail,
  ritual: RitualDetail,
  pact: PactDetail,
  consumable: ConsumableDetail,
  damage_type: DamageTypeDetail,
  skill: SkillDetail,
  spirit: SpiritDetail,
};
const Body = map[rec.kind] ?? GenericDetail;
const isPage = rec.kind === 'page';
const code = `${sectionCode(rec.kind)}-${String(rec.id ?? 0).padStart(4, '0')}`;
const typeLabel = section?.singular ?? rec.kind;
// The head line under the title: what kind of thing it is, in the book's own words.
const head = isPage ? rec.chapter : [rec.group && rec.group !== section?.label ? rec.group : '', rec.record_type && rec.record_type !== rec.group ? rec.record_type : ''].filter(Boolean).join(' · ');
const facts = factsFor(rec);
// Long titles step down a size so a word never breaks at the giant size.
const longestWord = Math.max(...String(rec.name).split(/\s+/).map((w) => w.length));
const crumbSection = section && !section.hidden ? section : null;
---

<article class:list={['file', `kind-${rec.kind}`]} data-rk={rec.kind} data-rn={rec.name}>
  <section class="file-hd">
    <div class="file-l">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Codex</a><span aria-hidden="true">/</span>
        {crumbSection && <a href={`/${crumbSection.route}`}>{crumbSection.label}</a>}
        {crumbSection && <span aria-hidden="true">/</span>}
        <span aria-current="page">{rec.name}</span>
      </nav>
      <div class="fileline" style={`--c:${GROUP_COLOR[section?.group ?? 'World']}`}>
        <span>File {code}</span>
        <span class="hot">{typeLabel}</span>
        <span class="dim">{rec.custom && rec.made_on ? `Custom · made on ${rec.made_on}` : rec.source}</span>
        {rec.outdated && <span class="warn" title="Made for an older PHB: check it still fits.">Outdated</span>}
      </div>
      <h1 class:list={['board', { long: longestWord > 11 || rec.name.length > 26 }]} data-t={rec.name}>{rec.name}</h1>
      {head && <p class="head">{head}</p>}
      <div class="badges">
        {rec.origin && <span class="tag yel" title="Faction / origin">{rec.origin}</span>}
        {rec.custom && <span class="tag red">Custom</span>}
        {rec.outdated && <span class="tag yel">Outdated</span>}
        {!rec.custom && <span class="tag">{rec.source}</span>}
        {!isPage && (
          <button type="button" class="cmp-btn" data-cmp data-cmp-k={rec.kind} data-cmp-s={rec.slug} data-cmp-n={rec.name} data-cmp-h={`${hrefFor(rec.kind, rec.slug)}/`} aria-pressed="false">
            <span aria-hidden="true">⇄</span> <span data-cmp-t>Compare</span>
          </button>
        )}
      </div>
      {
        rec.custom && (
          <p class="custom-note">
            <b>{rec.origin ? `${rec.origin} · Custom.` : 'Custom.'}</b> {rec.origin ? `${rec.origin} content, added by the group's GM` : 'Added by the group’s GM'} against PHB {rec.made_on || '—'}{rec.outdated ? ', flagged outdated (the current PHB has moved on; check it still fits).' : '.'} It lives outside the book, so it stays in the codex across PHB versions.
          </p>
        )
      }
      {
        facts.length > 0 && (
          <dl class="glance facts" style="margin-top:16px">
            {facts.map((f) => (
              <div class:list={{ wide: f.wide }}>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
    <div class="file-r">
      <Sigil rec={rec} id="plate" />
    </div>
  </section>
  <div class="file-body cols">
    <Body rec={rec}>
      <EntrySide slot="side" rec={rec} />
    </Body>
  </div>
</article>
