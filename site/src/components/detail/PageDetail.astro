---
import { renderMarkdown } from '../../lib/md';
import { hrefFor } from '../../lib/sections';
import { loadFull } from '../../lib/data';

interface Props { rec: any; }
const { rec } = Astro.props;
const html = renderMarkdown(rec.body_md);

// Records extracted from this same source file (so a chapter links to its entries).
const KINDS = ['discipline', 'feat', 'rune', 'weapon', 'armor', 'material', 'archetype', 'condition', 'action'];
const related: { kind: string; name: string; slug: string }[] = [];
for (const k of KINDS) {
  for (const r of loadFull(k) as any[]) {
    if (r.source_path === rec.source_path || r.page_slug === rec.slug) related.push({ kind: k, name: r.name, slug: r.slug });
  }
}
---

<div class="file-main">
  <div class="page-prose" set:html={html} />
</div>
<aside class="file-side">
  {related.length > 0 && (
    <section class="side-block">
      <h2 class="subh">On this page</h2>
      <ul class="side-list">
        {related.slice(0, 60).map((r) => (
          <li><a class="lnk" href={hrefFor(r.kind, r.slug)}>{r.name}</a></li>
        ))}
      </ul>
    </section>
  )}
  <slot name="side" />
</aside>
