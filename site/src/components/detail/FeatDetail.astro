---
import Icon from '../Icon.astro';
import Prose from '../Prose.astro';
import { hrefFor } from '../../lib/sections';

interface Props { rec: any; }
const { rec } = Astro.props;
const LABEL = 'subh';
const qualities = String(rec.qualities || '').split(/[,/|]+/).map((s) => s.trim()).filter(Boolean);
---

<div class="file-main">
  <div class="min-w-0 space-y-5">
    {rec.flavor && <p class="border-l-2 border-gold/40 pl-3 text-[15px] italic text-muted">“{rec.flavor}”</p>}
    {rec.effect && (
      <section>
        <h2 class={LABEL}>Effect</h2>
        <Prose text={rec.effect} />
      </section>
    )}
    {rec.limits && (
      <section>
        <h2 class={LABEL}>Limits</h2>
        <Prose text={rec.limits} />
      </section>
    )}
  </div>
</div>
<aside class="file-side">
      {rec.discipline_slug && (
        <a href={hrefFor('discipline', rec.discipline_slug)} class="inline-flex items-center gap-1.5 text-sm text-gold hover:underline">
          <Icon name="arrow-left" class="text-sm" />All of {rec.discipline_name}
        </a>
      )}
      {qualities.length > 0 && (
        <div>
          <h2 class={LABEL}>Qualities</h2>
          <div class="flex flex-wrap gap-1.5">
            {qualities.map((qy) => (
              <span class="rounded-md border border-line bg-surface px-2 py-1 text-xs text-muted">{qy}</span>
            ))}
          </div>
        </div>
      )}
  
  <slot name="side" />
</aside>
