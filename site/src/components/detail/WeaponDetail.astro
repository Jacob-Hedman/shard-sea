---
import Prose from '../Prose.astro';
import StatBlock from '../StatBlock.astro';

interface Props { rec: any; }
const { rec } = Astro.props;
const LABEL = 'mb-1.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-faint';
const rows = [
  { label: 'Group', value: rec.weapon_group },
  { label: 'Mode', value: rec.mode },
  { label: 'Tier', value: rec.tier != null ? String(rec.tier) : '' },
  { label: 'Cost', value: rec.cost },
  { label: 'Accuracy', value: rec.accuracy },
  { label: 'Bulk', value: rec.bulk },
  { label: 'Durable', value: rec.durable },
];
const traits = String(rec.traits || '').split(/,\s*/).map((s) => s.trim()).filter(Boolean);
---

<div class="lg:grid lg:grid-cols-[1fr_18rem] lg:gap-8">
  <aside class="mb-6 space-y-4 lg:order-2 lg:mb-0 lg:sticky lg:top-20 lg:self-start">
    <StatBlock rows={rows} />
  </aside>
  <div class="min-w-0 space-y-5 lg:order-1">
    {rec.summary && <p class="text-[15px] leading-relaxed text-muted">{rec.summary}</p>}
    {traits.length > 0 && (
      <section>
        <h2 class={LABEL}>Traits</h2>
        <div class="flex flex-wrap gap-1.5">
          {traits.map((t) => <span class="rounded-md border border-line bg-surface px-2 py-1 font-mono text-xs text-muted">{t}</span>)}
        </div>
      </section>
    )}
    {rec.special && (
      <section>
        <h2 class={LABEL}>Special</h2>
        <Prose text={rec.special} />
      </section>
    )}
  </div>
</div>
