---
import Prose from '../Prose.astro';

interface Props { rec: any; }
const { rec } = Astro.props;
const LABEL = 'subh';
// The trait line ("Tier_1, Active_1 Hour/1 Day, Deadly_2 Edible") -> chips.
const traits = String(rec.traits || '').split(/,\s*/).map((s: string) => s.trim()).filter(Boolean);
const extra: Record<string, string> = rec.extra ?? {};
---

<div class="file-main">
  <div class="min-w-0 space-y-5">
    {rec.summary && <p class="text-[15px] leading-relaxed text-muted">{rec.summary}</p>}
    {rec.effect && (
      <section>
        <h2 class={LABEL}>Effect</h2>
        <Prose text={rec.effect} />
      </section>
    )}
    {Object.entries(extra).map(([k, v]) => (
      <section>
        <h2 class={LABEL}>{k}</h2>
        <Prose text={v} />
      </section>
    ))}
  </div>
</div>
<aside class="file-side">
      {traits.length > 0 && (
        <div>
          <h2 class={LABEL}>Traits</h2>
          <div class="flex flex-wrap gap-1.5">
            {traits.map((t: string) => (
              <span class="rounded-md border border-line bg-surface px-2 py-1 font-mono text-xs text-muted">{t}</span>
            ))}
          </div>
        </div>
      )}
  
  <slot name="side" />
</aside>
