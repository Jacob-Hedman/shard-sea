---
import Prose from '../Prose.astro';

interface Props { rec: any; }
const { rec } = Astro.props;
const LABEL = 'subh';
---

<div class="file-main">
  <div class="min-w-0 space-y-5">
    {rec.summary && rec.summary !== rec.effects && (
      <p class="text-[15px] leading-relaxed text-muted">{rec.summary}</p>
    )}
    {rec.effects && (
      <section>
        <h2 class={LABEL}>Effect</h2>
        <Prose text={rec.effects} />
      </section>
    )}
  </div>
</div>
<aside class="file-side">
  <slot name="side" />
</aside>
