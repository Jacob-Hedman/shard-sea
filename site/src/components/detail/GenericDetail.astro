---
import StatBlock from '../StatBlock.astro';
import Prose from '../Prose.astro';
import { hrefFor } from '../../lib/sections';

// Fallback renderer — used for runes and materials (and any future kind without
// a bespoke component). Key attributes become a stat block; flavor + effects
// render as prose.
interface Props { rec: any; }
const { rec } = Astro.props;
const LABEL = 'mb-1.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-faint';

const attrs = rec.attrs ?? {};
const SKIP = new Set(['description', 'panic_flavor', 'Record']);
const rows = [
  rec.rune_class && { label: 'Class', value: rec.rune_class },
  rec.multiplier && { label: 'Multiplier', value: rec.multiplier },
  rec.applies_to && { label: 'Applies to', value: rec.applies_to },
  ...Object.entries(attrs)
    .filter(([k, v]) => !SKIP.has(k) && !['Class', 'Multipier', 'Multiplier', 'applies_to'].includes(k) && v && String(v).length < 60)
    .map(([k, v]) => ({ label: k.replace(/_/g, ' '), value: v as any })),
].filter(Boolean) as { label: string; value: any }[];

const flavor = rec.summary || attrs.description || '';
const body = rec.effects || rec.description || attrs.description || rec.text || '';
---

<div class:list={[rows.length > 0 && 'lg:grid lg:grid-cols-[1fr_16rem] lg:gap-8']}>
  {rows.length > 0 && (
    <aside class="mb-6 space-y-4 lg:order-2 lg:mb-0 lg:sticky lg:top-20 lg:self-start">
      <StatBlock rows={rows} />
      {rec.discipline_slug && (
        <a href={hrefFor('discipline', rec.discipline_slug)} class="inline-flex items-center gap-1.5 text-sm text-gold hover:underline">
          <i class="ti ti-arrow-left text-sm" aria-hidden="true"></i>{rec.discipline_name}
        </a>
      )}
    </aside>
  )}
  <div class="min-w-0 space-y-5 lg:order-1">
    {flavor && flavor !== body && <p class="border-l-2 border-gold/40 pl-3 text-[15px] italic text-muted">“{flavor}”</p>}
    {body && (
      <section>
        <h2 class={LABEL}>Effect</h2>
        <Prose text={body} />
      </section>
    )}
  </div>
</div>
