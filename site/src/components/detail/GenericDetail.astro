---
import Icon from '../Icon.astro';
import Prose from '../Prose.astro';
import { GENERIC_SKIP as SKIP, SHORT } from '../../lib/facts';
import { hrefFor } from '../../lib/sections';

// Fallback renderer — used for runes and materials (and any future kind without
// a bespoke component). Short attributes are the header's facts (lib/facts.ts);
// flavor, effects and long attributes render here as prose.
interface Props { rec: any; }
const { rec } = Astro.props;
const LABEL = 'subh';

const attrs = rec.attrs ?? {};

// Long sub-label blocks (Time, Procedure, Limits, Collaboration…) read as
// sections, not as cramped stat rows — this is what Activities are made of.
// A lead paragraph (the descriptive text), then an "Effect" section only when
// the mechanics text actually differs from it — so descriptive-only kinds
// (resources, weapon traits) aren't mislabelled "Effect" or shown twice.
// rec.text is only a lead when it isn't just the effects again (a record with no
// descriptive text, e.g. a custom Weapon Group, should still get its Effect section).
const lead = rec.summary || attrs.description || (rec.text !== rec.effects ? rec.text : '') || '';
const effectText = rec.effects && String(rec.effects).trim() && rec.effects !== lead
  ? rec.effects : '';
// Long sub-label blocks (Time, Procedure, Limits, Collaboration…) read as sections, not as
// cramped stat rows; this is what Activities are made of. A block that repeats the lead or
// the effect (a District's "Effects") is left out.
const same = (a: unknown, b: unknown) => String(a ?? '').replace(/\s+/g, ' ').trim() === String(b ?? '').replace(/\s+/g, ' ').trim();
const longBlocks = (Object.entries(attrs).filter(
  ([k, v]) => !SKIP.has(k) && typeof v === 'string' && v.length > SHORT,
) as [string, string][]).filter(([, v]) => !same(v, lead) && !same(v, effectText));
---

<div class="file-main">
  <div class="min-w-0 space-y-5">
    {lead && <p class="text-[15px] leading-relaxed text-muted">{lead}</p>}
    {effectText && (
      <section>
        <h2 class={LABEL}>Effect</h2>
        <Prose text={effectText} />
      </section>
    )}
    {longBlocks.map(([k, v]) => (
      <section>
        <h2 class={LABEL}>{k.replace(/_/g, ' ')}</h2>
        <Prose text={v} />
      </section>
    ))}
  </div>
</div>
<aside class="file-side">
  {rec.discipline_slug && (
    <a href={hrefFor('discipline', rec.discipline_slug)} class="side-link"><Icon name="arrow-left" /> All of {rec.discipline_name}</a>
  )}
  <slot name="side" />
</aside>
