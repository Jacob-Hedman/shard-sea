---
import Prose from '../Prose.astro';
import StatBlock from '../StatBlock.astro';

interface Props { rec: any; }
const { rec } = Astro.props;
const LABEL = 'mb-1.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-faint';
const rows = [
  { label: 'Kind', value: rec.category },
  { label: 'Fits', value: rec.attrs?.Equipment },
  { label: 'Bulk', value: rec.bulk },
  { label: 'Cost', value: rec.cost },
  { label: 'Activation', value: rec.activation },
  ...(rec.custom ? [{ label: 'Made on', value: rec.made_on }] : []),
];
const patterns = String(rec.pattern || '').split(/,\s*/).map((s: string) => s.trim()).filter(Boolean);
---

<div class="lg:grid lg:grid-cols-[1fr_18rem] lg:gap-8">
  <aside class="mb-6 space-y-4 lg:order-2 lg:mb-0 lg:sticky lg:top-20 lg:self-start">
    <StatBlock rows={rows} />
    {patterns.length > 0 && (
      <div>
        <h2 class={LABEL}>Runic Pattern</h2>
        <div class="flex flex-wrap gap-1.5">
          {patterns.map((p: string) => (
            <span class="rounded-md border border-line bg-surface px-2 py-1 font-mono text-xs text-muted">{p}</span>
          ))}
        </div>
      </div>
    )}
  </aside>
  <div class="min-w-0 space-y-5 lg:order-1">
    {rec.custom && (
      <div class="rounded-lg border border-arcane/40 bg-arcane/5 px-3.5 py-2.5 text-sm">
        <span class="font-semibold text-arcane">Custom item.</span>
        <span class="text-muted"> Made by a player against PHB {rec.made_on || '—'}{rec.outdated ? ' — flagged outdated (the current PHB has moved on; check it still fits).' : '.'} It lives outside the book, so it stays in the codex across PHB versions.</span>
      </div>
    )}
    {rec.description && <p class="text-[15px] leading-relaxed text-muted">{rec.description}</p>}
    {rec.effects && (
      <section>
        <h2 class={LABEL}>Effect</h2>
        <Prose text={rec.effects} />
      </section>
    )}
  </div>
</div>
