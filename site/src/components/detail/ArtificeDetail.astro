---
import Prose from '../Prose.astro';

interface Props { rec: any; }
const { rec } = Astro.props;
const LABEL = 'subh';
const patterns = String(rec.pattern || '').split(/,\s*/).map((s: string) => s.trim()).filter(Boolean);
---

<div class="file-main">
  <div class="min-w-0 space-y-5">
    {rec.description && <p class="text-[15px] leading-relaxed text-muted">{rec.description}</p>}
    {rec.effects && (
      <section>
        <h2 class={LABEL}>Effect</h2>
        <Prose text={rec.effects} />
      </section>
    )}
  </div>
</div>
<aside class="file-side">
      {patterns.length > 0 && (
        <div>
          <h2 class={LABEL}>Runic Pattern</h2>
          <div class="flex flex-wrap gap-1.5">
            {patterns.map((p: string) => (
              <span class="rounded-md border border-line bg-surface px-2 py-1 font-mono text-xs text-muted">{p}</span>
            ))}
          </div>
        </div>
      )}
  
  <slot name="side" />
</aside>
