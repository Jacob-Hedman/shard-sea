[{"id":326,"slug":"kiering","name":"Kiering","kind":"weapon","sub":"Knives · Tier 3","desc":"A finely crafted blade in the form of an inverse curve, something that reminds one of a claw.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Knives"],"mode":["Melee"],"tier":["Tier 3"]}},{"id":327,"slug":"ikon","name":"Ikon","kind":"weapon","sub":"Knives · Tier 3","desc":"The Expedition Elite Knife, straight with a reinforced, lethal point.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Knives"],"mode":["Melee"],"tier":["Tier 3"]}},{"id":328,"slug":"katasin","name":"Katasin","kind":"weapon","sub":"Knives · Tier 2","desc":"Strongly curved, long, and with a strong cross-guard.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Knives"],"mode":["Melee"],"tier":["Tier 2"]}},{"id":329,"slug":"rondel","name":"Rondel","kind":"weapon","sub":"Knives · Tier 2","desc":"A simple grip ending in a spike.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Knives"],"mode":["Melee"],"tier":["Tier 2"]}},{"id":330,"slug":"dagger","name":"Dagger","kind":"weapon","sub":"Knives · Tier 1","desc":"Reliable, exceling in little but failing nothing.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Knives"],"mode":["Melee"],"tier":["Tier 1"]}},{"id":331,"slug":"boot-knife","name":"Boot Knife","kind":"weapon","sub":"Knives · Tier 1","desc":"Extremely light, ready to be hurled at a moment's notice.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Knives"],"mode":["Melee"],"tier":["Tier 1"]}},{"id":332,"slug":"imperial-saber","name":"Imperial Saber","kind":"weapon","sub":"Sabers · Tier 3","desc":"While ornate, these Weapons have a foundation in the height of Verdun craftwork.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Sabers"],"mode":["Melee"],"tier":["Tier 3"]}},{"id":333,"slug":"estoc","name":"Estoc","kind":"weapon","sub":"Sabers · Tier 3","desc":"Impressively long and lacking a true edge.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Sabers"],"mode":["Melee"],"tier":["Tier 3"]}},{"id":334,"slug":"ghal","name":"Ghal","kind":"weapon","sub":"Sabers · Tier 2","desc":"Transparently Orkish in design, often viewed as impolite to carry about.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Sabers"],"mode":["Melee"],"tier":["Tier 2"]}},{"id":335,"slug":"hilted-saber","name":"Hilted Saber","kind":"weapon","sub":"Sabers · Tier 2","desc":"An elegant, sweeping blade made for duels which still sees use as a side-arm abroad.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Sabers"],"mode":["Melee"],"tier":["Tier 2"]}},{"id":336,"slug":"falx","name":"Falx","kind":"weapon","sub":"Sabers · Tier 1","desc":"An inverted curve lends this blade some of brutality of an Axe, while retaining a Saber's speed.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Sabers"],"mode":["Melee"],"tier":["Tier 1"]}},{"id":337,"slug":"long-knife","name":"Long-Knife","kind":"weapon","sub":"Sabers · Tier 1","desc":"Swift and precise, the Long-Knife is the most popular of Sabers for its emphasis of the Group's best qualities.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Sabers"],"mode":["Melee"],"tier":["Tier 1"]}},{"id":338,"slug":"khal-har","name":"Khal'Har","kind":"weapon","sub":"Cleavers · Tier 3","desc":"Bearing an Orkish name with a forgotten meaning, these are used almost exclusively by Expeditioners on the hunt of great beasts.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Cleavers"],"mode":["Melee"],"tier":["Tier 3"]}},{"id":339,"slug":"sea-fin","name":"Sea-Fin","kind":"weapon","sub":"Cleavers · Tier 3","desc":"A sleeker curve, both more beautiful and more agile than most.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Cleavers"],"mode":["Melee"],"tier":["Tier 3"]}},{"id":340,"slug":"vala","name":"Vala","kind":"weapon","sub":"Cleavers · Tier 2","desc":"Somewhat out-of-place for Verdun craft, Valar are two-edged blades with a pronounced cross-guard.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Cleavers"],"mode":["Melee"],"tier":["Tier 2"]}},{"id":341,"slug":"honor-blade","name":"Honor Blade","kind":"weapon","sub":"Cleavers · Tier 2","desc":"A balanced and light variation on the Cleaver, the Honor Blade emphasizes the Verdun preference in blades with a compromise for extended range.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Cleavers"],"mode":["Melee"],"tier":["Tier 2"]}},{"id":342,"slug":"executioner-s-sword","name":"Executioner's Sword","kind":"weapon","sub":"Cleavers · Tier 1","desc":"A deadly, monstrous arc of metal intended for inflicting mortal wounds. These bear little Verdun influence, a truly Orkish design.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Cleavers"],"mode":["Melee"],"tier":["Tier 1"]}},{"id":343,"slug":"field-sword","name":"Field Sword","kind":"weapon","sub":"Cleavers · Tier 1","desc":"Long in the handle and precise, a Field Sword can be used to deliver hewing chops and cuts while keeping the wielder out of harm's way.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Cleavers"],"mode":["Melee"],"tier":["Tier 1"]}},{"id":344,"slug":"dragon-nail","name":"Dragon Nail","kind":"weapon","sub":"Polearms · Tier 3","desc":"Enormous and unwieldy, these Polearms are indicated for large and especially resistant foes.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Polearms"],"mode":["Melee"],"tier":["Tier 3"]}},{"id":345,"slug":"halberd","name":"Halberd","kind":"weapon","sub":"Polearms · Tier 3","desc":"Associated with the Nobility, Halberds have a ceremonial air, but remain a ruthlessly effective Weapon.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Polearms"],"mode":["Melee"],"tier":["Tier 3"]}},{"id":346,"slug":"glaive","name":"Glaive","kind":"weapon","sub":"Polearms · Tier 2","desc":"The hybried of Polearm and Cleaver, a Glaive is used to deliver terrible chopping blows to distant enemies.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Polearms"],"mode":["Melee"],"tier":["Tier 2"]}},{"id":347,"slug":"pike","name":"Pike","kind":"weapon","sub":"Polearms · Tier 2","desc":"Long an deadly-sharp, Pikes are useful for engagement even across the decks of engaged smaller vessels.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Polearms"],"mode":["Melee"],"tier":["Tier 2"]}},{"id":348,"slug":"lance","name":"Lance","kind":"weapon","sub":"Polearms · Tier 1","desc":"A hunting Weapon first, then taken up by nobles in the Conquest, now used to skewer Beasts in the Shard Sea.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Polearms"],"mode":["Melee"],"tier":["Tier 1"]}},{"id":349,"slug":"spear","name":"Spear","kind":"weapon","sub":"Polearms · Tier 1","desc":"Simple design, replicated ten-thousand-fold for its reliability and wide uses. Spears are rarely a bad choice.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Polearms"],"mode":["Melee"],"tier":["Tier 1"]}},{"id":350,"slug":"war-arc","name":"War Arc","kind":"weapon","sub":"Axes · Tier 3","desc":"Highly performant, a design honed over centuries of battle.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Axes"],"mode":["Melee"],"tier":["Tier 3"]}},{"id":351,"slug":"ghurank","name":"Ghurank","kind":"weapon","sub":"Axes · Tier 3","desc":"A monstrous slab of serrated iron.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Axes"],"mode":["Melee"],"tier":["Tier 3"]}},{"id":352,"slug":"poleaxe","name":"Poleaxe","kind":"weapon","sub":"Axes · Tier 2","desc":"Comparatively inexpensive and reliable, the Poleaxe is the preferred weapon of many Outpost Militias.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Axes"],"mode":["Melee"],"tier":["Tier 2"]}},{"id":353,"slug":"beast-cutter","name":"Beast Cutter","kind":"weapon","sub":"Axes · Tier 2","desc":"A truly Orkish Design, Beast Cutters embrace brutality at all cost.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Axes"],"mode":["Melee"],"tier":["Tier 2"]}},{"id":354,"slug":"bearded-axe","name":"Bearded Axe","kind":"weapon","sub":"Axes · Tier 1","desc":"The Verdun touch applied to the Axe, creating a relatively balanced Weapon that keeps its cruel nature closer to the chest.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Axes"],"mode":["Melee"],"tier":["Tier 1"]}},{"id":355,"slug":"handaxe","name":"Handaxe","kind":"weapon","sub":"Axes · Tier 1","desc":"The tool form remains in use, both for practical purpose and to throw. The latter application is seen as a highly skillfull activity.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Axes"],"mode":["Melee"],"tier":["Tier 1"]}},{"id":356,"slug":"inkhos","name":"Inkhos","kind":"weapon","sub":"Bludgeons · Tier 3","desc":"The Weapon of choice for Elite Guardsmen, functionally something like a pole-hammer.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Bludgeons"],"mode":["Melee"],"tier":["Tier 3"]}},{"id":357,"slug":"bar","name":"Bar","kind":"weapon","sub":"Bludgeons · Tier 3","desc":"An immense span of raw metal, keenly impractical for any task except simply crushing whatever misfortunate ends up below its face.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Bludgeons"],"mode":["Melee"],"tier":["Tier 3"]}},{"id":358,"slug":"tolka","name":"Tolka","kind":"weapon","sub":"Bludgeons · Tier 2","desc":"Longer than most and fitted with a double head, one a crushing surface and the other a spike.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Bludgeons"],"mode":["Melee"],"tier":["Tier 2"]}},{"id":359,"slug":"maul","name":"Maul","kind":"weapon","sub":"Bludgeons · Tier 2","desc":"Heavy, impractical in many circumstances, but brutally effective. Mauls are best used with support to blitz tougher foes.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Bludgeons"],"mode":["Melee"],"tier":["Tier 2"]}},{"id":360,"slug":"hammer","name":"Hammer","kind":"weapon","sub":"Bludgeons · Tier 1","desc":"Well balanced and simple, hafted for use in 1 or 2 hands, the Hammer is the favored Weapon of Telmarine Priests and also Shield-bearing Expeditioners.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Bludgeons"],"mode":["Melee"],"tier":["Tier 1"]}},{"id":361,"slug":"mace","name":"Mace","kind":"weapon","sub":"Bludgeons · Tier 1","desc":"A hollow metal shaft with cruciform head, the Mace is surprisingly fast in the right hands while still able to deliver the crushing power of a Bludgeon.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Bludgeons"],"mode":["Melee"],"tier":["Tier 1"]}},{"id":362,"slug":"dragon-slayer","name":"Dragon Slayer","kind":"weapon","sub":"Bows · Tier 3","desc":"Heavy enough to buckle a slighter soldier and requiring the strength of nearly two adults to draw, the Dragon Slayer was and is a boast in itself to even wield.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Bows"],"mode":["Ranged"],"tier":["Tier 3"]}},{"id":363,"slug":"arbalest","name":"Arbalest","kind":"weapon","sub":"Bows · Tier 3","desc":"Bolts from an Arbalest strike like a hammer-blow, punching as much as penetrating their targets, thrown from Steel-banded crossed limbs and string.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Bows"],"mode":["Ranged"],"tier":["Tier 3"]}},{"id":364,"slug":"longbow","name":"Longbow","kind":"weapon","sub":"Bows · Tier 2","desc":"The practical choice for most archers, Longbows are noble Weapons with a form given by centuries of practice and refinement.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Bows"],"mode":["Ranged"],"tier":["Tier 2"]}},{"id":365,"slug":"belly-bow","name":"Belly Bow","kind":"weapon","sub":"Bows · Tier 2","desc":"The workhorse of less trained Militia, precise and effective, if slow.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Bows"],"mode":["Ranged"],"tier":["Tier 2"]}},{"id":366,"slug":"shortbow","name":"Shortbow","kind":"weapon","sub":"Bows · Tier 1","desc":"A footsoldier's Bow, Shortbows are easily transported and less strenuous to use, sporting a superior accuracy at the cost of power.","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Bows"],"mode":["Ranged"],"tier":["Tier 1"]}},{"id":367,"slug":"crossbow","name":"Crossbow","kind":"weapon","sub":"Bows","desc":"A simple weapon, easy to fire, less so rapidly.","tier":null,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Bows"],"mode":["Ranged"],"tier":[]}},{"id":368,"slug":"long-arquebus","name":"Long Arquebus","kind":"weapon","sub":"Arquebuses · Tier 3","desc":"Sharp, dangerous, and heavy. The Long Arquebus is an anti-armor Weapon designed for single, punishing shots.","tier":3,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Arquebuses"],"mode":["Ranged"],"tier":["Tier 3"]}},{"id":369,"slug":"military-arquebus","name":"Military Arquebus","kind":"weapon","sub":"Arquebuses · Tier 2","desc":"The armament for the militia soldier and Expeditioners alike. Military Arquebusses are simple, effective, and practical.","tier":2,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Arquebuses"],"mode":["Ranged"],"tier":["Tier 2"]}},{"id":370,"slug":"light-arquebus","name":"Light Arquebus","kind":"weapon","sub":"Arquebuses · Tier 1","desc":"Meant to be wielded in a single Hand, the Light Arquebus is equal parts side-arm and tool. Sub-optimal for sheer lethality, but many Expeditioners carry these for firing grapnels and other special Bo…","tier":1,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Arquebuses"],"mode":["Ranged"],"tier":["Tier 1"]}},{"id":371,"slug":"incendiary","name":"Incendiary","kind":"weapon","sub":"Special Ammo","desc":"","tier":null,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Special Ammo"],"mode":["Ranged"],"tier":[]}},{"id":372,"slug":"explosive-bolts","name":"Explosive Bolts","kind":"weapon","sub":"Special Ammo","desc":"","tier":null,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Special Ammo"],"mode":["Ranged"],"tier":[]}},{"id":373,"slug":"dragon-piercer","name":"Dragon Piercer","kind":"weapon","sub":"Special Ammo","desc":"","tier":null,"source":"PHB v17","content_type":"official","license":"homebrew","facets":{"content_type":["official"],"license":["homebrew"],"source":["PHB v17"],"weapon_group":["Special Ammo"],"mode":["Ranged"],"tier":[]}}]